<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog id="managePinCodeDialog" title="{json>/title}">
		<content>
			<VBox class="sapUiSmallMargin">
				<f:SimpleForm id="changeForm" minWidth="1024" maxContainerCols="2" editable="true" layout="ResponsiveGridLayout" title="{json>/action}"
					labelSpanL="3" labelSpanM="3" emptySpanL="4" emptySpanM="4" columnsL="1" columnsM="1" class="editableForm">
					<f:content>
						<Label text="User Name"/>
						<Input id="userName" value="{json>/FullName}" editable="false" />
						<Label text="Passcode" visible="{json>/visFlag1}"/>
						<Input id="checkPasscode" value="{json>/checkPasscode}" placeholder="Enter Pin (Numbers Only)" visible="{json>/visFlag1}"
							   type="Tel" class="HiddenField" required="true"/>
						<Label text="Old Passcode" visible="{json>/visFlag2}"/>
						<Input id="oldPasscode" value="{json>/oldPasscode}" placeholder="Old Pin  (Numbers Only)" visible= "{json>/visFlag2}"
							   type="Tel" class="HiddenField"  required="true"/>
						<Label text="New Passcode" visible= "{json>/visFlag3}"/>
						<Input id="newPasscode" value="{json>/newPasscode}" placeholder="New Pin (Numbers Only)" visible= "{json>/visFlag3}"
							   type="Tel" class="HiddenField" required="true"/>
						<Label text="Confirm New Passcode" visible= "{json>/visFlag3}"/>
						<Input id="confirmNewPasscode" value="{json>/confirmNewPasscode}" placeholder="New Pin (Numbers Only)" visible= "{json>/visFlag3}"
							   type="Tel" class="HiddenField" required="true"/>
					</f:content>
				</f:SimpleForm>
			</VBox>
		</content>
		<beginButton>
			<Button id="confirmBtn" type="Accept" 
					text="{json>/confirmBtnTitle}" press="onChangePin">
			</Button>
		</beginButton>
		<endButton>
			<Button id="cancelBtn" type="Reject" visible="{json>/visFlag2}"
					text="{json>/cancelBtnTitle}" press="onCancel">
			</Button>
		</endButton>
	</Dialog>
</core:FragmentDefinition>