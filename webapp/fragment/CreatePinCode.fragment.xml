<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog id="createPinCodeDialog" title="Create New Pin">
		<content>
			<VBox class="sapUiSmallMargin">
				<f:SimpleForm id="createForm" minWidth="1024" maxContainerCols="2" editable="true" layout="ResponsiveGridLayout" title="Authenticate"
					labelSpanL="3" labelSpanM="3" emptySpanL="4" emptySpanM="4" columnsL="1" columnsM="1" class="editableForm">
					<f:content>
						<Label text="Passcode"/>
						<Input id="passcode" value="" placeholder="Provide your Unique Passcode" 
							   type="Password" required="true"/>
					</f:content>
				</f:SimpleForm>
			</VBox>
		</content>
		<endButton>
			<Button id="confirmBtn" type="Accept" 
					text="Ok" press="onCreatePin">
			</Button>
		</endButton>
	</Dialog>
</core:FragmentDefinition>