{
  "_version": "1.5.0",
  "sap.app": {
    "id": "com.csr.flp.ext",
    "type": "component",
    "title": "FLP Extension",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.194"
    },
    "sourceTemplate": {
      "id": "servicecatalog.connectivityComponent",
      "version": "0.0.0",
      "toolsId": "97a14a7d-cb12-4719-8392-86c8dcb2e772"
    },
    "crossNavigation": {
      "inbounds": {
        "Shell-plugin": {
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          },
          "hideLauncher": true,
          "semanticObject": "Shell",
          "action": "plugin"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://detail-view",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "supportedThemes": [
      "sap_hcb",
      "sap_bluecrystal"
    ]
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.csr.flp.ext.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.71.76",
      "libs": {
        "sap.ui.core": {
          "minVersion": "1.71.72"
        },
        "sap.m": {
          "minVersion": "1.71.72"
        },
        "sap.ushell": {
          "minVersion": "1.71.69"
        },
        "sap.collaboration": {
          "minVersion": "1.71.72",
          "lazy": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.csr.flp.ext.i18n.i18n"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.csr.flp.ext.view",
        "controlId": "idAppControl",
        "controlAggregation": "detailPages",
        "bypassed": {
          "target": []
        },
        "async": true
      },
      "routes": [],
      "targets": {}
    },
    "resourceRoots": {
      "com.csr.flp.ext": "./"
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    }
  },
  "sap.platform.hcp": {
    "uri": "",
    "_version": "1.1.0"
  },
  "sap.cloud": {
    "public": true,
    "service": "comcsrflpext"
  },
  "sap.flp": {
              "type": "plugin"
  }
}
