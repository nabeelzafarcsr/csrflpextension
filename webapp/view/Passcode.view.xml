<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" controllerName="com.csr.flp.ext.controller.Passcode"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<App>
		<Dialog id="authDialog" title="Switch User">
		<content>
			<VBox class="sapUiSmallMargin">
				<f:SimpleForm id="SimpleForm" minWidth="1024" maxContainerCols="2" editable="true" layout="ResponsiveGridLayout" title="Authnticate"
					labelSpanL="3" labelSpanM="3" emptySpanL="4" emptySpanM="4" columnsL="1" columnsM="1" class="editableForm">
					<f:content>
						<Label text="Passcode"/>
						<Input id="passcode" value="" placeholder="Provide your Unique Passcode" 
							   type="Password" required="true"/>
					</f:content>
				</f:SimpleForm>
			</VBox>
		</content>
		<beginButton>
			<Button id="confirmBtn" type="Accept" 
					text="Confirm" press="onConfirm">
			</Button>
		</beginButton>
		<endButton>
			<Button id="cancelBtn" type="Reject"
					text="Cancel" press="onCancel">
			</Button>
		</endButton>
	</Dialog>
	</App>
</mvc:View>